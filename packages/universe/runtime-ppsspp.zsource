schema=zen-source-1
id=org.zenov.runtime.ppsspp
version=1.0.0
kind=runtime
platform=zenov
architecture=x86_64
artifact=metadata
delivery=metadata-only
runtime=native
availability=planned
entrypoint=/system/runtimes/ppsspp/ppsspp
provider-abi=zen-runtime-provider-1
launch-mode=external
channel=stable
category=gaming
license=GPL-2.0-or-later
description=PlayStation Portable emulator provider contract for legally owned user-supplied game assets.
homepage=https://www.ppsspp.org/
bytes=0
sha256=-
accepts=cso
accepts=disc-image
accepts=iso
accepts=pbp
requires=audio.stream
requires-any=graphics.opengl3.0|graphics.vulkan1.0
requires=input.gamepad
requires=kernel.mmap
requires=kernel.processes
requires=kernel.threads
requires=storage.large-files
provides=runtime.ppsspp
