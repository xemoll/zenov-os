schema=zen-source-1
id=org.zenov.runtime.duckstation
version=1.0.0
kind=runtime
platform=zenov
architecture=x86_64
artifact=metadata
delivery=metadata-only
runtime=native
availability=planned
entrypoint=/system/runtimes/duckstation/duckstation
provider-abi=zen-runtime-provider-1
launch-mode=external
channel=stable
category=gaming
license=CC-BY-NC-ND-4.0
description=PlayStation 1 emulator provider contract for legally owned user-supplied game and BIOS assets.
homepage=https://github.com/stenzek/duckstation
bytes=0
sha256=-
accepts=bin-cue
accepts=chd
accepts=disc-image
accepts=pbp
accepts=psx-exe
asset=firmware.playstation1-bios
requires=audio.stream
requires=cpu.sse4.1
requires-any=graphics.opengl3.1|graphics.vulkan1.0
requires=input.gamepad
requires=kernel.jit
requires=kernel.mmap
requires=kernel.processes
requires=kernel.threads
requires=storage.large-files
provides=runtime.duckstation
arg=-batch
arg=--
arg=%artifact%
