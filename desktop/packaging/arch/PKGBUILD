# Maintainer: Zenov project
pkgname=zen-apps
pkgver=r1
pkgrel=1
pkgdesc='Standalone local-first Notes, Tasks, Calendar, Clock, Calculator and Reminders'
arch=('x86_64' 'aarch64')
url='https://github.com/xemoll/zenov-os'
license=('BSD-2-Clause')
depends=('qt6-base')
makedepends=('cmake' 'ninja' 'git')
options=('!debug')
source=("git+https://github.com/xemoll/zenov-os.git")
sha256sums=('SKIP')

pkgver() {
  cd zenov-os
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=8 HEAD)"
}

build() {
  cmake -S zenov-os/desktop -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
